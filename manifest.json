{
  "manifest_version": 3,
  "name": "Grade Lens for FOM",
  "version": "0.1.0",
  "description": "Your FOM grade trajectory, final-grade range and what you need in each open exam. Runs entirely in your browser.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://oc-digital.de/*"
      ],
      "js": [
        "src/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://oc-digital.de/*"
      ],
      "js": [
        "src/model.js",
        "src/panel.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
