{
  "manifest_version": 3,
  "name": "Grade Lens for FOM",
  "version": "0.4.0",
  "description": "Your FOM grade trajectory, final-grade range and what you need in each open exam. Runs entirely in your browser.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://oc-digital.de/*"
      ],
      "js": [
        "src/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://oc-digital.de/*"
      ],
      "js": [
        "src/model.js",
        "src/panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Grade Lens",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "minimum_chrome_version": "111"
}
